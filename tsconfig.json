{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["**/*.js", "**/*.mjs", "**/*.cjs"],
  "exclude": ["node_modules", "dist", "backend/**/dist", "frontend/**/dist"]
}
